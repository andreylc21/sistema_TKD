{
  "name": "sistema-tkd-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "contract:generate": "openapi-typescript ../docs/openapi.yaml -o src/shared/api/generated.ts",
    "contract:check": "openapi-typescript ../docs/openapi.yaml -o src/shared/api/generated.ts --check",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "npm run contract:check && npm run typecheck && vite build",
    "verify": "npm run contract:check && npm run format:check && npm run lint && npm run typecheck && npm run test && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
